# Copy this file to .env.ecs (repository root) or pass it with --env-file.
# .env.ecs is git-ignored. Never commit real credentials.

# --- Task 3: domain + HTTPS + access control --------------------------------
# Domain or subdomain whose DNS A record points at the ECS public IPv4.
DOMAIN=ai.example.com
# E-mail used to register the Let's Encrypt certificate with Certbot.
CERTBOT_EMAIL=you@example.com
# Basic Auth user name and password protecting the site. The password is asked
# for by the browser; keep it out of your report and repository.
BASIC_AUTH_USER=student
# Leave empty to let the script generate a random password and print it once.
BASIC_AUTH_PASSWORD=
# Set to 1 to continue when the A record does not match ECS_PUBLIC_IP yet.
SKIP_DNS_CHECK=0

# --- Shared with scripts/deploy-ecs.sh -------------------------------------
ECS_HOST=203.0.113.10
ECS_USER=root
ECS_PORT=22
# ECS_SSH_KEY=/home/you/.ssh/id_ed25519
ECS_PUBLIC_IP=203.0.113.10
AILA_BACKEND_PORT=14242
