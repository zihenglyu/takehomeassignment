# Copy this file to .env.ecs (repository root) and fill in your own values.
# .env.ecs is git-ignored. Never commit real credentials or API keys.

# --- Alibaba Cloud Container Registry (ACR) --------------------------------
# Example personal registry: registry.cn-hangzhou.aliyuncs.com
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
# Your ACR namespace (the path segment before the repository name).
ACR_NAMESPACE=your-namespace
# Repository name created in ACR.
ACR_REPO=ai-learning-assistant
# ACR username and password from the ACR console (not your Aliyun login).
ACR_USERNAME=your-acr-username
ACR_PASSWORD=your-acr-password
IMAGE_TAG=latest

# --- Aliyun ECS instance ---------------------------------------------------
# Public IPv4 address or host name of the ECS instance.
ECS_HOST=203.0.113.10
ECS_USER=root
ECS_PORT=22
# Absolute path to the private key used to log in to the ECS (omit if your key
# is already loaded in ssh-agent or configured in ~/.ssh/config).
# ECS_SSH_KEY=/Users/you/.ssh/id_ed25519
ECS_APP_DIR=/opt/ai-learning-assistant
# Public IPv4 used when the check script probes http://<ip>:14242/ui/.
ECS_PUBLIC_IP=203.0.113.10

# --- Application -----------------------------------------------------------
AILA_BACKEND_PORT=14242
MODEL_PROVIDER=openai_compatible
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.6-flash
# Server-side Qwen key so ECS users get AI service without entering their own.
# Leave empty to require each user to enter a personal key in the app.
MODEL_API_KEY=
MODEL_CONTEXT_WINDOW=1000000
MODEL_SUPPORTS_STREAMING=true
